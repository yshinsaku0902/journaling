# === 本番（Vercel）で設定する環境変数 ===
# これらが未設定の場合、アプリは自動でデモモード（ログイン不要・ローカルファイル保存・Outlookはサンプル）で動きます。

# Vercel Postgres (Neon) の接続文字列
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Microsoft Entra ID (Azure AD) アプリ登録の値
# AZURE_AD_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_AD_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# AZURE_AD_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Auth.js のセッション暗号化キー（`npx auth secret` などで生成）
# AUTH_SECRET=change-me

# このアプリにログインできるメールアドレス（カンマ区切り）。空なら全許可。
# ALLOWED_EMAILS=yshinsaku0902@gmail.com
